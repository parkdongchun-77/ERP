{
  "name": "erp-system-desktop",
  "productName": "ERP System",
  "version": "1.3.0",
  "description": "ERP System 데스크톱 클라이언트",
  "main": "main.js",
  "author": "moahagwon",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:renderer": "node build-renderer.js",
    "start": "electron .",
    "test": "electron smoke-test.js",
    "dist": "node build-renderer.js && electron-builder --win nsis --publish never",
    "release": "node build-renderer.js && electron-builder --win nsis --publish never && node release.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.moahagwon.erp",
    "productName": "ERP System",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "creds.js", "updater.js", "renderer/**/*", "package.json"],
    "publish": [{ "provider": "github", "owner": "parkdongchun-77", "repo": "ERP", "releaseType": "release" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP System",
      "artifactName": "ERP-System-Setup-${version}.${ext}"
    }
  }
}
