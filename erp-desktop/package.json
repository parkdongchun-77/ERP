{
  "name": "erp-system-desktop",
  "productName": "ERP System",
  "version": "1.1.0",
  "description": "ERP System 데스크톱 클라이언트",
  "main": "main.js",
  "author": "moahagwon",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moahagwon.erp",
    "productName": "ERP System",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "renderer/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP System",
      "artifactName": "ERP-System-Setup-${version}.${ext}"
    }
  }
}
